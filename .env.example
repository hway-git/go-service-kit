# 可选部署配置文件，留空使用 Go 默认值。
CONFIG_FILE=

# 数据库和 SMTP 凭据。
MYSQL_DSN=
REDIS_PASSWORD=
EMAIL_PASSWORD=

# 管理后台使用的 Redis 键前缀和 JWT 签名密钥。
REDIS_KEY_PREFIX=
JWT_SECRET=

# 仅在初始化后台时填写。
BOOTSTRAP_ADMIN_USER=
BOOTSTRAP_ADMIN_PASSWORD=

# 可选 R2 凭据及 RSA 私钥文件路径。
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
RSA_PRIVATE_KEY_FILE=
